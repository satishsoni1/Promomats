APP_NAME=VODO
APP_ENV=testing
APP_KEY=base64:X7F3NbecwAaEt7e/Z6rnIOMrAihwaQsdNqrJXZT9aJc=
APP_DEBUG=true
APP_TIMEZONE=UTC

# Isolated from the real dev database on purpose - tests use RefreshDatabase, which
# runs migrate:fresh, and must never touch the local `promomats` MySQL database this
# app actually develops against. sqlite in-memory isn't usable here: some existing
# migrations use raw `ALTER TABLE ... MODIFY` (MySQL-only) syntax, so tests run
# against a dedicated `promomats_testing` MySQL database instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=promomats_testing
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=4
