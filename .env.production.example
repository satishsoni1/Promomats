# Production environment template for VODO.
#
# Copy to .env on the production server, fill in every CHANGE-ME, then run:
#   php artisan key:generate --force   (only if APP_KEY is still blank)
# Never commit a filled-in .env anywhere. See DEPLOYMENT.md for the full checklist
# this file is one part of.

APP_NAME=VODO
APP_ENV=production
APP_KEY=                          # generate with `php artisan key:generate --force`, then keep it secret and stable
APP_DEBUG=false                   # MUST be false - true leaks stack traces, env values, and query bindings on every error page
APP_TIMEZONE=UTC
APP_URL=https://CHANGE-ME.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Daily-rotating log file (Laravel keeps 14 days by default) instead of one
# ever-growing single file - LOG_LEVEL=error keeps production logs signal, not noise.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=CHANGE-ME
DB_PORT=3306
DB_DATABASE=CHANGE-ME
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true        # requires the site to be served over HTTPS - see DEPLOYMENT.md
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# sync (the local-dev default) blocks every request on notification delivery -
# database is the simplest durable queue with no extra service to run beyond a
# supervised `php artisan queue:work`. Migrations for this already exist
# (jobs / failed_jobs tables) - just flip this and start the worker.
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=CHANGE-ME
MAIL_PORT=465
MAIL_USERNAME=CHANGE-ME
MAIL_PASSWORD=CHANGE-ME
MAIL_FROM_ADDRESS=CHANGE-ME
MAIL_FROM_NAME="${APP_NAME}"
# Alternative: leave the above blank and configure Gmail SMTP from inside the app at
# Admin > Mail Settings instead - it overrides these at runtime (MailConfigServiceProvider).

# Only needed if Admin > Cold Storage Settings is enabled for an S3-compatible tier -
# otherwise leave blank, the cold_storage disk stays a harmless local stub.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
